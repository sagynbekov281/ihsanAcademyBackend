# ---- Сервер ----
PORT=5000
# Адрес(а) фронтенда, которым разрешено обращаться к API, через запятую
CLIENT_ORIGIN=http://localhost:5173
SMS_PROVIDER=console

# ---- MongoDB ----
# Строка подключения MongoDB Atlas (бесплатный кластер M0)
mongodb+srv://academy:academyddesire@cluster0.3evkigq.mongodb.net/ihsan_academy?retryWrites=true&w=majority&appName=Cluster0
# ---- Админ-доступ к списку заявок ----
# Любая длинная случайная строка, придумай сам
ADMIN_API_KEY=academy-local-admin-key

# ---- SMS ----
# Варианты: console | nikita | smsc
# console — ничего реально не отправляет, просто пишет текст SMS в лог сервера (для разработки/теста)
SMS_PROVIDER=console

# --- Если SMS_PROVIDER=nikita (smspro.nikita.kg) ---
NIKITA_LOGIN=
NIKITA_PASSWORD=
NIKITA_SENDER=IhsanAcademy

# --- Если SMS_PROVIDER=smsc (smsc.ru) ---
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=IhsanAcademy
